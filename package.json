{
  "name": "web-studio-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Northlane Studio, a fictional web studio: a demo business website by MihailoBuilds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
