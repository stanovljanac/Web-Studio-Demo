    "qa:numbers": "node scripts/qa/numbers.mjs",
    "qa:main": "node scripts/qa/main.mjs",
    "qa:site": "node scripts/qa/site.mjs",
    "qa:shots": "node scripts/qa/shots.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
